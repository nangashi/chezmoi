# =============================================================================
# Claude Code Development Container
# Single container + worktree strategy for memory efficiency
# =============================================================================
FROM node:22-slim

ARG USERNAME=dev
ARG USER_UID=1000
ARG USER_GID=1000

# --- System packages ---------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    jq \
    tree \
    zsh \
    sudo \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# --- User setup --------------------------------------------------------------
RUN groupmod -g ${USER_GID} node \
    && usermod -u ${USER_UID} -g ${USER_GID} -s /bin/zsh node \
    && usermod -l ${USERNAME} node \
    && usermod -d /home/${USERNAME} -m ${USERNAME} \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/${USERNAME}

# --- Claude Code -------------------------------------------------------------
RUN npm install -g @anthropic-ai/claude-code

USER ${USERNAME}

# --- Mise --------------------------------------------------------------------
RUN curl https://mise.run | sh

WORKDIR /workspace

CMD ["sleep", "infinity"]
