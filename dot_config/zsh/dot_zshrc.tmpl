# chezmoi init用の設定保持
export GIT_NAME={{ .git_name }}
export GIT_EMAIL={{ .git_email }}
export WINDOWS_USERNAME={{ .windows_username }}

# ローカルbinディレクトリをPATHに追加
export PATH="$HOME/.local/bin:$PATH"

# cursor導入時にcodeコマンドでvscodeを起動するようにパスを追加
export PATH="/mnt/c/Users/{{ .windows_username }}/AppData/Local/Programs/Microsoft VS Code/bin:$PATH"

# ブラウザ設定
export BROWSER="/mnt/c/Program Files (x86)/Microsoft/Edge/Application/msedge.exe"

# brew
if [ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# p10kの有効化
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# mise
if command -v mise &> /dev/null; then
  eval "$(mise activate zsh)"
fi

# zshパッケージ管理Sheldonの有効化
if command -v sheldon &> /dev/null; then
  eval "$(sheldon source)"
fi

# 汎用設定
setopt print_eight_bit       # 日本語ファイル名を表示可能にする
setopt no_beep               # ビープ音停止
setopt nolistbeep            # 補完時のビープ音停止
# エイリアス
abbr -q -S dc="docker compose"
abbr -q -S mr="mise run"
alias ls="eza -F -h -@ -m --icons --git --time-style=long-iso --color=automatic --group-directories-first"
alias ll="eza -F -l -aa -h -@ -m --icons --git --time-style=long-iso --color=automatic --group-directories-first"
# 色関係
autoload -Uz colors          # 色を使用できるようにする
colors
# ディレクトリ補完でも着色
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
# 補完
autoload -Uz compinit
compinit
setopt auto_param_slash      # ディレクトリ補完時にスラッシュまで付ける
setopt list_types            # 補完候補に識別マークをつける(ls -F)
setopt magic_equal_subst     # パラメータのイコール以降で補完を有効にする
setopt extended_glob         # 拡張グロブ（*や^）で補完する
setopt globdots              # ドット指定なしでもドット付きファイルにマッチする
# 補完で小文字でも大文字にマッチさせる
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
# 補完をカーソルで選択できるようにする
zstyle ':completion:*:default' menu select=2
# 補完の説明表示
zstyle ':completion:*' verbose yes
zstyle ':completion:*:messages' format '%F{yellow}%d%f'
zstyle ':completion:*:warnings' format '%F{red}No matches for:%f %F{yellow}%d%f'
zstyle ':completion:*:descriptions' format '%F{yellow}completing %B%d%b%f'
zstyle ':completion:*:options' description 'yes'
# コマンド履歴
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt hist_ignore_all_dups  # 重複するコマンド行は古い方を削除
setopt hist_ignore_dups      # 直前と同じコマンドラインはヒストリに追加しない
setopt share_history         # コマンド履歴ファイルを共有する
setopt append_history        # 履歴を追加 (毎回 .zsh_history を作るのではなく)
setopt inc_append_history    # 履歴をインクリメンタルに追加
setopt hist_no_store         # historyコマンドは履歴に登録しない
setopt hist_reduce_blanks    # 余分な空白は詰めて記録
# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f "${ZDOTDIR:-$HOME}/.p10k.zsh" ]] || source "${ZDOTDIR:-$HOME}/.p10k.zsh"
# ==================================================
# 外部ツール
# ==================================================
# mise
if command -v mise &> /dev/null; then
  eval "$(mise completion zsh)"
fi
# fzf
if command -v fzf &> /dev/null; then
  eval "$(fzf --zsh)"
  export FZF_DEFAULT_OPTS='
    --color=bg+:#293739,bg:#1B1D1E,border:#808080,spinner:#E6DB74,hl:#7E8E91,fg:#F8F8F2,header:#7E8E91,info:#A6E22E,pointer:#A6E22E,marker:#F92672,fg+:#F8F8F2,prompt:#F92672,hl+:#F92672
  '
fi
# zoxide
if command -v zoxide &> /dev/null; then
  eval "$(zoxide init zsh)"
fi
# zoxide + fzf インタラクティブ検索
fzf-zoxide-search() {
    local res=$(zoxide query -l | fzf)
    if [ -n "$res" ]; then
        BUFFER="cd ${(q)res}"
        zle accept-line
    else
        return 1
    fi
}
zle -N fzf-zoxide-search
bindkey '^f' fzf-zoxide-search
# ==================================================
# スクリプト
# ==================================================
# git switch
gs() {
  local branches branch
  branches=$(git branch -vv) &&
  branch=$(echo "$branches" | fzf +m) &&
  git switch $(echo "$branch" | awk '{print $1}' | sed "s/.* //")
}
# git log
gl() {
  git log --graph --color=always \
      --format="%C(auto)%h%d %s %C(black)%C(bold)%cr" "$@" |
  fzf --ansi --no-sort --reverse --tiebreak=index --bind=ctrl-s:toggle-sort \
      --bind "ctrl-m:execute:
                (grep -o '[a-f0-9]\{7\}' | head -1 |
                xargs -I % sh -c 'git show --color=always % | less -R') << 'FZF-EOF'
                {}
FZF-EOF"
}
# git interactive rebase
gir() {
  local commit
  commit=$(git log --color=always --graph --date=short --decorate=short --pretty=format:'%Cgreen%h %Creset%cd %Cblue%cn %Cred%d %Creset%s' | \
          fzf --ansi --reverse --no-sort | sed -e 's#[\*|\/]##g' -e 's#^ \+##' | cut -f1 -d' ')
  [ -n "$commit" ] && git rebase -i "$commit"
}
# git fetch
gf() {
  local branch
  git fetch || return 1
  branch=$(git branch -a --color=always | grep remotes/ | sort -r | fzf --ansi --reverse | sed -e 's#^ \+remotes/origin/##')
  [ -z "$branch" ] && return 1
  git fetch origin "$branch" && git switch "$branch"
}
# git branch -c
gb() {
    # 引数がない場合はブランチ名を入力させる
    if [ -z "$1" ]; then
        echo -n "ブランチ名を入力してください: "
        read branch_name
    else
        branch_name="$1"
    fi
    # ブランチ名の変換処理
    if [[ $branch_name == f/* ]]; then
        # f/ で始まる場合は feature/ に変換
        branch_name="feature/${branch_name#f/}"
    elif [[ $branch_name == r/* ]]; then
        # r/ で始まる場合は release/ に変換
        branch_name="release/${branch_name#r/}"
    fi
    # 現在のブランチ名を取得
    current_branch=$(git symbolic-ref --short HEAD 2>/dev/null)
    # 新しいブランチを作成
    git checkout -b "$branch_name"
    if [ $? -eq 0 ]; then
        echo "ブランチ '$current_branch' から '$branch_name' を作成しました"
    else
        echo "ブランチの作成に失敗しました"
    fi
}

# gwq session
tm2() {
    local selected=$(ghq list --full-path | fzf --reverse --preview 'git -C {} log --oneline -5')
    [ -z "$selected" ] && return

    local session_name=$(basename "$selected" | tr '.=' '-')

    if tmux has-session -t "$session_name" 2>/dev/null; then
      tmux switch-client -t "$session_name"
    else
      tmux new-session -d -s "$session_name" -c "$selected"
      tmux switch-client -t "$session_name"
    fi
  }
